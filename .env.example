# Environment Variables Example
# Copy this file to .env and fill in your actual values

# Azure Active Directory Configuration
AZURE_AD_CLIENT_ID=your-azure-ad-client-id-here
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret-here
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id-here

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-here-use-openssl-rand-base64-32

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/performance_management

# Azure Application Insights (optional — enables error/event telemetry)
# If unset, logger falls back to structured JSON on stdout.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxxx;IngestionEndpoint=https://...

# Rate limiting (optional — defaults to in-memory per-process)
# For horizontal scale across Next.js instances, set RATELIMIT_STORE=redis
# then wire a client in lib/rateLimit.ts (see makeRedisStore()).
# RATELIMIT_STORE=redis
# REDIS_URL=redis://default:password@host:6379

# Password login in production (off by default; dev always allows it)
# Set to 'true' ONLY if you have a documented reason — otherwise Azure AD only.
# ALLOW_PASSWORD_LOGIN=false

# Email Provider (optional)
# EMAIL_PROVIDER=azure  # or 'resend' or unset for DB-only/log mode
# AZURE_COMM_CONNECTION_STRING=endpoint=https://xxx.communication.azure.com/;accesskey=xxx
# AZURE_COMM_SENDER_ADDRESS=noreply@yourdomain.com
# RESEND_API_KEY=re_xxxxx