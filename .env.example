# Example environment variables for hearts-app

# PostgreSQL Database URL
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://pgadmin:heartsAppDB@1@postgresb5506c87.postgres.database.azure.com:5432/postgres

# NextAuth.js secret for session encryption
NEXTAUTH_SECRET=your_nextauth_secret

# NextAuth.js URL (for production, set to your deployed URL)
NEXTAUTH_URL=http://localhost:3000

# For auth cokkie. set to your deployed URL
NEXTAUTH_DOMAIN=localhost

# (Optional) Azure App Service app name
AZURE_WEBAPP_NAME=your-app-service-name

# (Optional) Other secrets or API keys
# API_KEY=your-api-key
