generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-1.1.x", "linux-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum GoalStatus {
  DRAFT
  PENDING
  ACTIVE
  NEEDS_REVISION
  ON_HOLD
  BLOCKED
  COMPLETED
  CLOSED
}

enum CommentType {
  COMMENT
  APPROVAL
  REVISION_REQUEST
  DISCUSSION_REQUEST
  HOLD_REASON
  BLOCK_REASON
}

enum CycleType {
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum CycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CLOSED
}

enum EventStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ParticipationStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum MealPreference {
  NONE
  VEG
  NON_VEG
}

enum BadgeKind {
  FIRST_GOAL_DONE
  FIVE_GOALS_DONE
  TWENTY_FIVE_GOALS_DONE
  HUNDRED_GOALS_DONE
  ON_TIME_STREAK_10
  FIRST_HEART
  TEN_HEARTS
  FIFTY_HEARTS
  HUNDRED_HEARTS
  VALUE_CHAMPION
  KIND_SOUL_50
  CATEGORY_EXPLORER_5
  MENTOR_3
}

// ============================================================
// USER (extended from existing)
// ============================================================

model User {
  id                  String    @id @default(cuid())
  tenantId            String
  email               String
  name                String
  role                Role      @default(EMPLOYEE)
  password            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  failedLoginAttempts Int       @default(0)
  lastLoginAt         DateTime?
  lastLoginAttempt    DateTime?
  department          String?
  isActive            Boolean   @default(true)
  position            String? // Designation: "Senior Software Engineer", "QA Lead"
  jobCategory         String? // Job level: "Executive", "Senior Executive", "Manager"
  appointmentDate     DateTime? // Date of appointment / hire date
  reviewMonth         String? // Calculated or manual review month: "April", "October"
  // Review schedule tracking
  // nextReviewDate defaults to appointmentDate + 6 months but admins can
  // override it (the "Adjusted" column in imported Excel).
  nextReviewDate         DateTime?
  lastReviewCompletedAt  DateTime?
  // Timestamp of the latest auto/manual review-due reminder; prevents the
  // cron from re-sending within the same window. Cleared when a review is
  // marked complete.
  reviewReminderSentAt   DateTime?
  managerId           String?

  // Self-referential manager relationship
  manager   User?  @relation("ManagerEmployee", fields: [managerId], references: [id], onDelete: SetNull)
  employees User[] @relation("ManagerEmployee")

  // Hearts relations
  heartsGiven    Heart[] @relation("HeartSender")
  heartsReceived Heart[] @relation("HeartReceiver")

  // Goal relations
  goals         Goal[] @relation("GoalOwner")
  goalsAssigned Goal[] @relation("GoalAssigner")

  // Review relations
  selfReviews    Review[] @relation("ReviewEmployee")
  managerReviews Review[] @relation("ReviewManager")

  // Event participation
  eventParticipations EventParticipation[]

  // Audit log
  auditLogs AuditLog[]

  // In-app notifications
  notifications Notification[]

  // Earned achievement badges
  badges UserBadge[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, managerId])
  @@index([tenantId, role])
  @@index([tenantId, isActive])
  @@index([tenantId, role, isActive])
}

// ============================================================
// HEARTS RECOGNITION
// ============================================================

model CompanyValue {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  hearts Heart[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Heart {
  id         String   @id @default(cuid())
  tenantId   String
  senderId   String
  receiverId String
  valueTagId String
  message    String?
  createdAt  DateTime @default(now())

  sender   User         @relation("HeartSender", fields: [senderId], references: [id], onDelete: Restrict)
  receiver User         @relation("HeartReceiver", fields: [receiverId], references: [id], onDelete: Restrict)
  valueTag CompanyValue @relation(fields: [valueTagId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, receiverId])
  @@index([tenantId, senderId])
  @@index([tenantId, receiverId, createdAt])
}

// ============================================================
// GOAL TEMPLATES
// ============================================================

model GoalTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([tenantId, title])
  @@index([tenantId])
}

// ============================================================
// GOAL MANAGEMENT
// ============================================================

model Goal {
  id            String     @id @default(cuid())
  tenantId      String
  title         String
  description   String?
  category      String?
  targetDate    DateTime?
  status        GoalStatus @default(DRAFT)
  progress      Int        @default(0)
  ownerId       String
  assignerId    String?
  objectiveId   String?
  reviewCycleId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  owner       User          @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  assigner    User?         @relation("GoalAssigner", fields: [assignerId], references: [id], onDelete: SetNull)
  reviewCycle ReviewCycle?  @relation(fields: [reviewCycleId], references: [id], onDelete: SetNull)
  comments    GoalComment[]

  @@index([tenantId, ownerId, status])
  @@index([tenantId, status])
  @@index([tenantId, reviewCycleId])
}

model GoalComment {
  id        String      @id @default(cuid())
  tenantId  String
  goalId    String
  authorId  String
  content   String
  type      CommentType @default(COMMENT)
  createdAt DateTime    @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([tenantId, goalId])
  @@index([tenantId, authorId])
}

// ============================================================
// REVIEW CYCLES
// ============================================================

model ReviewCycle {
  id        String      @id @default(cuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  type      CycleType
  status    CycleStatus @default(DRAFT)
  createdAt DateTime    @default(now())

  reviews Review[]
  goals   Goal[]

  @@index([tenantId, status])
}

model Review {
  id                 String    @id @default(cuid())
  tenantId           String
  reviewCycleId      String
  employeeId         String
  managerId          String
  selfComments       String?
  selfRating         Int?
  selfSubmittedAt    DateTime?
  managerComments    String?
  managerRating      Int?
  managerSubmittedAt DateTime?
  isFinalized        Boolean   @default(false)
  finalizedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  reviewCycle ReviewCycle @relation(fields: [reviewCycleId], references: [id], onDelete: Restrict)
  employee    User        @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  manager     User        @relation("ReviewManager", fields: [managerId], references: [id], onDelete: Restrict)

  @@unique([tenantId, reviewCycleId, employeeId])
  @@index([tenantId, reviewCycleId])
  @@index([tenantId, managerId])
}

// ============================================================
// COMPANY EVENTS
// ============================================================

model Event {
  id          String      @id @default(cuid())
  tenantId    String
  title       String
  description String?
  dateTime    DateTime
  location    String?
  eventType   String?
  status      EventStatus @default(SCHEDULED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  participations EventParticipation[]

  @@index([tenantId, dateTime])
}

model EventParticipation {
  id             String              @id @default(cuid())
  tenantId       String
  eventId        String
  userId         String
  status         ParticipationStatus @default(PENDING)
  mealPreference MealPreference      @default(NONE)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId, userId])
  @@index([tenantId, eventId])
}

// ============================================================
// AUDIT & NOTIFICATIONS
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
}

model EmailNotification {
  id          String    @id @default(cuid())
  tenantId    String
  recipientId String
  type        String
  subject     String
  body        String
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("PENDING")

  @@index([tenantId, status, scheduledAt])
}

model Notification {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  type       String
  title      String
  message    String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@index([tenantId, userId, createdAt])
}

model UserBadge {
  id       String    @id @default(cuid())
  tenantId String
  userId   String
  kind     BadgeKind
  earnedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, kind])
  @@index([tenantId, userId])
  @@index([tenantId, earnedAt])
}
