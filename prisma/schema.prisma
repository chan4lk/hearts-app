generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-1.1.x", "linux-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  name                String
  role                Role           @default(EMPLOYEE)
  password            String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  failedLoginAttempts Int            @default(0)
  lastLoginAt         DateTime?
  lastLoginAttempt    DateTime?
  department          String?
  isActive            Boolean        @default(true)
  position            String?
  managerId           String?
  createdGoals        Goal[]         @relation("CreatedGoals")
  deletedGoals        Goal[]         @relation("DeletedGoals")
  goals               Goal[]         @relation("EmployeeGoals")
  managerGoals        Goal[]         @relation("ManagerGoals")
  updatedGoals        Goal[]         @relation("UpdatedGoals")
  notifications       Notification[]
  managerRatings      Rating[]       @relation("ManagerRatings")
  selfRatings         Rating[]       @relation("SelfRatings")
  manager             User?          @relation("UserToUser", fields: [managerId], references: [id])
  employees           User[]         @relation("UserToUser")
  reviewCycle         ReviewCycle?   @relation("UserReviewCycle")
  reportingPersonFor  ReviewCycle[]  @relation("ReviewCycleReportingPerson")
  updatedReviewCycles ReviewCycle[]  @relation("ReviewCycleUpdater")
  goalChangeLogs      GoalChangeLog[] @relation("GoalChanges")
  goalTemplates       GoalTemplate[] @relation("GoalTemplateCreator")
  escalatedGoals      Goal[]         @relation("EscalatedGoals")
  peerRatingsGiven    PeerRating[]   @relation("PeerRater")
  peerRatingsReceived PeerRating[]   @relation("PeerRated")
  pipAsEmployee       PerformanceImprovementPlan[] @relation("PIPEmployee")
  pipAsManager        PerformanceImprovementPlan[] @relation("PIPManager")
  calibrationSessions CalibrationParticipant[]
  createdEvents       Event[]        @relation("EventCreatedBy")
  eventParticipations EventParticipation[]

  // Foreign key indexes
  @@index([managerId])
  
  // Frequently filtered fields
  @@index([role])
  @@index([department])
  @@index([isActive])
  @@index([createdAt])
  
  // Search indexes - email already has @unique (implicit index), name used for search
  @@index([name])
  
  // Composite indexes for common query patterns
  @@index([role, isActive])          // Get active users by role
  @@index([managerId, isActive])     // Get active employees for a manager
  @@index([department, isActive])    // Get active users by department
  @@index([role, department])        // Users by role and department
  @@index([isActive, createdAt])     // Active users sorted by date
  @@index([failedLoginAttempts])     // For account lockout checks
}

model Goal {
  id                 String         @id @default(cuid())
  title              String
  description        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  dueDate            DateTime
  managerId          String?
  employeeId         String
  approvedAt         DateTime?
  approvedBy         String?
  rejectedAt         DateTime?
  rejectedBy         String?
  status             GoalStatus     @default(DRAFT)
  managerComments    String?
  category           GoalCategory   @default(PROFESSIONAL)
  createdById        String?
  deletedAt          DateTime?
  deletedById        String?
  updatedById        String?
  lastProgressUpdate DateTime?
  progress           Float          @default(0)
  progressStatus     ProgressStatus @default(NOT_STARTED)
  progressNotes      String?
  department         String         @default("ENGINEERING")
  priority           String         @default("MEDIUM")
  weight             Int            @default(10) // Goal importance weight (1-100). Higher = more strategic.
  version            Int            @default(1)  // Optimistic locking — incremented on each update
  reviewCycleId      String?        // Links goal to a review cycle period
  parentGoalId       String?        // OKR hierarchy: links to parent goal (company → team → individual)
  ratingType         String         @default("ORDINAL") // BINARY, ORDINAL (1-5), SCALE_100 (0-100%)
  escalatedAt        DateTime?      // When goal was escalated for approval
  escalatedToId      String?        // Manager's manager who can approve if direct manager is absent
  permanentlyDeletedAt DateTime?    // GDPR: When goal data was permanently removed
  createdBy          User?          @relation("CreatedGoals", fields: [createdById], references: [id])
  deletedBy          User?          @relation("DeletedGoals", fields: [deletedById], references: [id])
  employee           User           @relation("EmployeeGoals", fields: [employeeId], references: [id])
  manager            User?          @relation("ManagerGoals", fields: [managerId], references: [id])
  updatedBy          User?          @relation("UpdatedGoals", fields: [updatedById], references: [id])
  reviewCycle        ReviewCycle?   @relation("GoalReviewCycle", fields: [reviewCycleId], references: [id])
  parentGoal         Goal?          @relation("GoalHierarchy", fields: [parentGoalId], references: [id])
  childGoals         Goal[]         @relation("GoalHierarchy")
  escalatedTo        User?          @relation("EscalatedGoals", fields: [escalatedToId], references: [id])
  notifications      Notification[]
  rating             Rating? // One-to-one: each goal has at most one rating record
  changeLogs         GoalChangeLog[]
  peerRatings        PeerRating[]

  // Foreign key indexes
  @@index([managerId])
  @@index([employeeId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@index([reviewCycleId])
  @@index([parentGoalId])
  @@index([escalatedToId])

  // Single column indexes for frequently filtered fields
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([department])
  @@index([createdAt])
  @@index([dueDate])
  // progressStatus index removed — never used in WHERE clauses
  
  // Composite indexes for common query patterns
  @@index([status, employeeId])        // Get goals by status for an employee
  @@index([status, managerId])         // Get goals by status for a manager
  @@index([employeeId, status])        // Alternative ordering for employee status queries
  @@index([category, status])          // Filter goals by category and status
  @@index([department, status])        // Filter goals by department and status
  @@index([status, dueDate])           // Find overdue goals by status
  @@index([employeeId, dueDate])       // Employee goals sorted by due date
  @@index([status, createdAt])         // Status-based queries sorted by creation date
  
  // Additional performance indexes for common queries
  @@index([employeeId, status, createdAt, dueDate]) // Employee dashboard queries
  @@index([managerId, status, createdAt]) // Manager review queries
  @@index([status, createdAt, dueDate]) // Analytics and sorting
}

// Audit trail for goal changes — tracks who changed what when
model GoalChangeLog {
  id         String   @id @default(cuid())
  goalId     String
  changedBy  String
  changedAt  DateTime @default(now())
  fieldName  String   // "status", "title", "dueDate", "weight", etc.
  oldValue   String?
  newValue   String?
  reason     String?  // Required for sensitive changes (status, weight, dueDate)
  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user       User     @relation("GoalChanges", fields: [changedBy], references: [id])

  @@index([goalId])
  @@index([changedBy])
  @@index([changedAt])
  @@index([goalId, changedAt])
}

model Rating {
  id        String   @id @default(cuid())
  goalId    String   @unique // One rating per goal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Self-rating fields (by employee)
  selfScore     Int? // Employee's self-rating score (1-5)
  selfComments  String? // Employee's comments
  selfRatedById String? // Who gave the self-rating
  selfRatedAt   DateTime? // When self-rating was submitted

  // Manager-rating fields (by manager)
  managerScore     Int? // Manager's rating score (1-5)
  managerComments  String? // Manager's feedback/comments
  managerRatedById String? // Who gave the manager-rating
  managerRatedAt   DateTime? // When manager-rating was submitted

  // Finalization
  selfFinalized    Boolean  @default(false)  // Once true, self-rating cannot be changed
  managerFinalized Boolean  @default(false)  // Once true, manager-rating cannot be changed
  reviewCycleId    String?  // Links rating to specific review cycle

  // Relations
  goal           Goal  @relation(fields: [goalId], references: [id])
  selfRatedBy    User? @relation("SelfRatings", fields: [selfRatedById], references: [id])
  managerRatedBy User? @relation("ManagerRatings", fields: [managerRatedById], references: [id])

  @@index([goalId])
  @@index([selfRatedById])
  @@index([managerRatedById])
}

model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  userId     String
  goalId     String?
  groupKey   String?          // For deduplication: "goal:{goalId}" or "cycle:{cycleId}"
  archivedAt DateTime?        // When notification was archived (null = active)
  goal       Goal?            @relation(fields: [goalId], references: [id])
  user       User             @relation(fields: [userId], references: [id])

  // Foreign key indexes
  @@index([userId])
  @@index([goalId])
  @@index([groupKey])

  // Frequently filtered and sorted fields
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@index([archivedAt])

  // Composite indexes for common query patterns
  @@index([userId, isRead])          // Get unread notifications for user
  @@index([userId, createdAt])       // User notifications sorted by date
  @@index([userId, isRead, createdAt]) // Optimized for unread notifications query
  @@index([userId, archivedAt])      // Active vs archived notifications
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum GoalStatus {
  PENDING
  APPROVED
  REJECTED
  MODIFIED
  COMPLETED
  DRAFT
  DELETED
  IN_PROGRESS
  ON_HOLD
  BLOCKED
  // NOT_STARTED removed — use ProgressStatus.NOT_STARTED for progress tracking instead
}

enum NotificationType {
  GOAL_CREATED
  GOAL_UPDATED
  GOAL_APPROVED
  GOAL_REJECTED
  GOAL_MODIFIED
  GOAL_COMPLETED
  GOAL_DELETED
  RATING_RECEIVED
  REVIEW_CYCLE_CREATED
  REVIEW_CYCLE_UPDATED
  REVIEW_CYCLE_DELETED
}

enum GoalCategory {
  PROFESSIONAL
  TECHNICAL
  LEADERSHIP
  PERSONAL
  TRAINING
  KPI
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  BLOCKED
  COMPLETED
}

model ReviewCycle {
  id                  String   @id @default(cuid())
  userId              String   @unique
  reportingPersonId   String?
  jobCategory         String?  // Executive, Senior Executive, etc.
  designation         String?  // Senior Software Engineer, QA Lead, etc.
  dateOfAppointment   DateTime? // Joined Date Company
  after6Months        String?  // Month name (October, etc.)
  reviewMonth         String?  // Month name (April, etc.)
  adjustedReviewMonth String?  // Month name (February, March, etc.)
  cycleStartDate      DateTime? // Proper start date of review cycle
  cycleEndDate        DateTime? // Proper end date of review cycle
  cycleStatus         String   @default("ACTIVE") // DRAFT, ACTIVE, CLOSED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  updatedById         String?
  user                User     @relation("UserReviewCycle", fields: [userId], references: [id])
  reportingPerson     User?    @relation("ReviewCycleReportingPerson", fields: [reportingPersonId], references: [id])
  updatedBy           User?    @relation("ReviewCycleUpdater", fields: [updatedById], references: [id])
  goals               Goal[]   @relation("GoalReviewCycle")

  @@index([userId])
  @@index([updatedById])
  @@index([reportingPersonId])
}

model Event {
  id                String                @id @default(cuid())
  title             String
  description       String
  eventType         EventType
  categoryLabel     String?               // Custom category when eventType is OTHER
  location          String?
  startDate         DateTime
  endDate           DateTime
  capacity          Int?
  registrationDeadline DateTime
  createdById       String
  createdBy         User                  @relation("EventCreatedBy", fields: [createdById], references: [id])
  status            EventStatus           @default(SCHEDULED)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  participations    EventParticipation[]

  @@index([createdById])
  @@index([status])
  @@index([eventType])
  @@index([startDate])
  @@index([endDate])
  @@index([status, startDate])
  @@index([eventType, status])
}

model EventParticipation {
  id                String    @id @default(cuid())
  eventId           String
  userId            String
  participationStatus ParticipationStatus @default(REGISTERED)
  toastmasterRole   String?   // For TOASTMASTERS: President, Toastmaster, Table Topics Master, etc.
  heartsTalkRole    String?   // For HEART_TALKS: PARTICIPANT | FACILITATOR
  hoursContributed  Float?
  feedback          String?
  registeredAt      DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  event             Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([participationStatus])
  @@index([eventId, participationStatus])
  @@index([userId, participationStatus])
}

enum EventType {
  TOASTMASTERS
  CODECRUNCH
  RBT_TRAINING
  TRAINING
  HEART_TALKS
  BISTEC_CLUB
  WORKSHOP
  SEMINAR
  NETWORKING
  TEAM_BUILDING
  OTHER
}

enum EventStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ParticipationStatus {
  REGISTERED
  ATTENDED
  NO_SHOW
  CANCELLED
}

// Goal templates for quick creation by role/department
model GoalTemplate {
  id          String       @id @default(cuid())
  name        String
  description String
  category    GoalCategory @default(PROFESSIONAL)
  department  String       @default("ENGINEERING")
  priority    String       @default("MEDIUM")
  weight      Int          @default(10)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String
  createdBy   User         @relation("GoalTemplateCreator", fields: [createdById], references: [id])

  @@index([department])
  @@index([category])
  @@index([isActive])
  @@index([createdById])
}

// GDPR: Archive of permanently deleted goal data (encrypted reference)
model GoalDeletionArchive {
  id              String   @id @default(cuid())
  originalGoalId  String
  deletedBy       String
  deletedAt       DateTime @default(now())
  reason          String
  goalTitle       String   // Snapshot for audit trail
  employeeId      String   // Who the goal belonged to
  permanentlyDeletedAt DateTime @default(now())

  @@index([deletedBy])
  @@index([employeeId])
  @@index([deletedAt])
}

// 360-degree peer feedback
model PeerRating {
  id         String   @id @default(cuid())
  goalId     String
  raterId    String   // Who gave the rating
  ratedForId String   // Who the rating is for
  score      Int      // 1-5 scale
  comments   String?
  createdAt  DateTime @default(now())
  goal       Goal     @relation(fields: [goalId], references: [id])
  rater      User     @relation("PeerRater", fields: [raterId], references: [id])
  ratedFor   User     @relation("PeerRated", fields: [ratedForId], references: [id])

  @@unique([goalId, raterId]) // One peer rating per goal per rater
  @@index([goalId])
  @@index([raterId])
  @@index([ratedForId])
}

// Performance Improvement Plans
model PerformanceImprovementPlan {
  id              String   @id @default(cuid())
  employeeId      String
  managerId       String
  startDate       DateTime
  endDate         DateTime
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED, FAILED, CANCELLED
  reason          String   // Why PIP was initiated
  successCriteria String   // JSON array of criteria
  checkInFrequency String  @default("BIWEEKLY") // WEEKLY, BIWEEKLY, MONTHLY
  outcome         String?  // Final outcome notes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  employee        User     @relation("PIPEmployee", fields: [employeeId], references: [id])
  manager         User     @relation("PIPManager", fields: [managerId], references: [id])

  @@index([employeeId])
  @@index([managerId])
  @@index([status])
}

// Calibration sessions for rating consistency across managers
model CalibrationSession {
  id           String   @id @default(cuid())
  name         String
  status       String   @default("DRAFT") // DRAFT, ACTIVE, CLOSED
  createdAt    DateTime @default(now())
  closedAt     DateTime?
  participants CalibrationParticipant[]

  @@index([status])
}

model CalibrationParticipant {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String   // Manager participating
  joinedAt    DateTime @default(now())
  session     CalibrationSession @relation(fields: [sessionId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}
