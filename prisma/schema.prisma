generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-1.1.x", "linux-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  name                String
  role                Role           @default(EMPLOYEE)
  password            String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  failedLoginAttempts Int            @default(0)
  lastLoginAt         DateTime?
  lastLoginAttempt    DateTime?
  department          String?
  isActive            Boolean        @default(true)
  position            String?
  managerId           String?
  createdGoals        Goal[]         @relation("CreatedGoals")
  deletedGoals        Goal[]         @relation("DeletedGoals")
  goals               Goal[]         @relation("EmployeeGoals")
  managerGoals        Goal[]         @relation("ManagerGoals")
  updatedGoals        Goal[]         @relation("UpdatedGoals")
  notifications       Notification[]
  managerRatings      Rating[]       @relation("ManagerRatings")
  selfRatings         Rating[]       @relation("SelfRatings")
  manager             User?          @relation("UserToUser", fields: [managerId], references: [id])
  employees           User[]         @relation("UserToUser")
  reviewCycle         ReviewCycle?   @relation("UserReviewCycle")
  reportingPersonFor  ReviewCycle[]  @relation("ReviewCycleReportingPerson")
  updatedReviewCycles ReviewCycle[]  @relation("ReviewCycleUpdater")

  // 360 Feedback
  feedbackRoundsAsEmployee  FeedbackRound[]   @relation("FeedbackRoundEmployee")
  feedbackRoundsInitiated   FeedbackRound[]   @relation("FeedbackRoundInitiator")
  feedbackReviews           FeedbackReview[]  @relation("FeedbackReviewer")

  // Meetings & Surveys
  meetingsAsEmployee        MeetingMinutes[]  @relation("MeetingEmployee")
  meetingsAsManager         MeetingMinutes[]  @relation("MeetingManager")
  surveys                   EmployeeSurvey[]  @relation("SurveyEmployee")

  // Exit Interviews
  exitInterviewsAsEmployee  ExitInterview[]   @relation("ExitInterviewEmployee")
  exitInterviewsAsManager   ExitInterview[]   @relation("ExitInterviewManager")

  // Foreign key and login-related indexes
  @@index([managerId])
  @@index([lastLoginAt])
  @@index([lastLoginAttempt])
  
  // Frequently filtered fields
  @@index([role])
  @@index([department])
  @@index([isActive])
  @@index([createdAt])
  
  // Composite indexes for common query patterns
  @@index([role, isActive])          // Get active users by role
  @@index([managerId, isActive])     // Get active employees for a manager
  @@index([department, isActive])    // Get active users by department
  @@index([role, department])        // Users by role and department
}

model Goal {
  id                 String         @id @default(cuid())
  title              String
  description        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  dueDate            DateTime
  managerId          String?
  employeeId         String
  approvedAt         DateTime?
  approvedBy         String?
  rejectedAt         DateTime?
  rejectedBy         String?
  status             GoalStatus     @default(DRAFT)
  managerComments    String?
  category           GoalCategory   @default(PROFESSIONAL)
  createdById        String?
  deletedAt          DateTime?
  deletedById        String?
  updatedById        String?
  lastProgressUpdate DateTime?
  progress           Float          @default(0)
  progressStatus     ProgressStatus @default(NOT_STARTED)
  progressNotes      String?
  department         String         @default("ENGINEERING")
  priority           String         @default("MEDIUM")
  createdBy          User?          @relation("CreatedGoals", fields: [createdById], references: [id])
  deletedBy          User?          @relation("DeletedGoals", fields: [deletedById], references: [id])
  employee           User           @relation("EmployeeGoals", fields: [employeeId], references: [id])
  manager            User?          @relation("ManagerGoals", fields: [managerId], references: [id])
  updatedBy          User?          @relation("UpdatedGoals", fields: [updatedById], references: [id])
  notifications      Notification[]
  rating             Rating? // One-to-one: each goal has at most one rating record

  // Foreign key indexes
  @@index([managerId])
  @@index([employeeId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  
  // Single column indexes for frequently filtered fields
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([department])
  @@index([createdAt])
  @@index([dueDate])
  @@index([progressStatus])
  
  // Composite indexes for common query patterns
  @@index([status, employeeId])        // Get goals by status for an employee
  @@index([status, managerId])         // Get goals by status for a manager
  @@index([employeeId, status])        // Alternative ordering for employee status queries
  @@index([category, status])          // Filter goals by category and status
  @@index([department, status])        // Filter goals by department and status
  @@index([status, dueDate])           // Find overdue goals by status
  @@index([employeeId, dueDate])       // Employee goals sorted by due date
  @@index([status, createdAt])         // Status-based queries sorted by creation date
}

model Rating {
  id        String   @id @default(cuid())
  goalId    String   @unique // One rating per goal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Self-rating fields (by employee)
  selfScore     Int? // Employee's self-rating score (1-5)
  selfComments  String? // Employee's comments
  selfRatedById String? // Who gave the self-rating
  selfRatedAt   DateTime? // When self-rating was submitted

  // Manager-rating fields (by manager)
  managerScore     Int? // Manager's rating score (1-5)
  managerComments  String? // Manager's feedback/comments
  managerRatedById String? // Who gave the manager-rating
  managerRatedAt   DateTime? // When manager-rating was submitted

  // Relations
  goal           Goal  @relation(fields: [goalId], references: [id])
  selfRatedBy    User? @relation("SelfRatings", fields: [selfRatedById], references: [id])
  managerRatedBy User? @relation("ManagerRatings", fields: [managerRatedById], references: [id])

  @@index([goalId])
  @@index([selfRatedById])
  @@index([managerRatedById])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    String
  goalId    String?
  goal      Goal?            @relation(fields: [goalId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  // Foreign key indexes
  @@index([userId])
  @@index([goalId])
  
  // Frequently filtered and sorted fields
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  
  // Composite indexes for common query patterns
  @@index([userId, isRead])          // Get unread notifications for user
  @@index([userId, createdAt])       // User notifications sorted by date
  @@index([userId, isRead, createdAt]) // Optimized for unread notifications query
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum GoalStatus {
  PENDING
  APPROVED
  REJECTED
  MODIFIED
  COMPLETED
  DRAFT
  DELETED
  IN_PROGRESS
  NOT_STARTED
  ON_HOLD
  BLOCKED
}

enum NotificationType {
  GOAL_CREATED
  GOAL_UPDATED
  GOAL_APPROVED
  GOAL_REJECTED
  GOAL_MODIFIED
  GOAL_COMPLETED
  GOAL_DELETED
  RATING_RECEIVED
  REVIEW_CYCLE_CREATED
  REVIEW_CYCLE_UPDATED
  REVIEW_CYCLE_DELETED
  // 360 Feedback
  FEEDBACK_ROUND_CREATED
  FEEDBACK_REVIEW_REQUESTED
  FEEDBACK_REVIEW_SUBMITTED
  FEEDBACK_ROUND_COMPLETED
  // Meeting & Surveys
  MEETING_MINUTES_CREATED
  SURVEY_REQUESTED
  SURVEY_SUBMITTED
  // Lifecycle Automation
  RATING_CYCLE_REMINDER
  RATING_CYCLE_COMPLETE
  GOAL_RENEWAL_DUE
  // Exit Interviews
  EXIT_INTERVIEW_CREATED
  EXIT_INTERVIEW_COMPLETED
}

enum GoalCategory {
  PROFESSIONAL
  TECHNICAL
  LEADERSHIP
  PERSONAL
  TRAINING
  KPI
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  BLOCKED
  COMPLETED
}

model ReviewCycle {
  id                  String   @id @default(cuid())
  userId              String   @unique
  reportingPersonId   String?
  jobCategory         String?  // Executive, Senior Executive, etc.
  designation         String?  // Senior Software Engineer, QA Lead, etc.
  dateOfAppointment   DateTime? // Joined Date Company
  after6Months        String?  // Month name (October, etc.)
  reviewMonth         String?  // Month name (April, etc.)
  adjustedReviewMonth String?  // Month name (February, March, etc.)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  updatedById         String?
  user                User     @relation("UserReviewCycle", fields: [userId], references: [id])
  reportingPerson     User?    @relation("ReviewCycleReportingPerson", fields: [reportingPersonId], references: [id])
  updatedBy           User?    @relation("ReviewCycleUpdater", fields: [updatedById], references: [id])

  @@index([userId])
  @@index([updatedById])
  @@index([reportingPersonId])
}

// ============ Phase 2: 360 Feedback ============

enum FeedbackRoundType {
  THREE_MONTH
  ANNUAL
}

enum FeedbackRoundStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FeedbackReviewStatus {
  PENDING
  SUBMITTED
}

model FeedbackRound {
  id            String              @id @default(cuid())
  type          FeedbackRoundType
  employeeId    String
  initiatedById String
  status        FeedbackRoundStatus @default(PENDING)
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  employee      User                @relation("FeedbackRoundEmployee", fields: [employeeId], references: [id])
  initiatedBy   User                @relation("FeedbackRoundInitiator", fields: [initiatedById], references: [id])
  reviews       FeedbackReview[]
  meetingMinutes MeetingMinutes[]

  @@index([employeeId])
  @@index([initiatedById])
  @@index([status])
}

model FeedbackReview {
  id              String               @id @default(cuid())
  feedbackRoundId String
  reviewerId      String
  score           Int?                 // 1-5
  comments        String?
  strengths       String?
  improvements    String?
  status          FeedbackReviewStatus @default(PENDING)
  submittedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  feedbackRound   FeedbackRound        @relation(fields: [feedbackRoundId], references: [id], onDelete: Cascade)
  reviewer        User                 @relation("FeedbackReviewer", fields: [reviewerId], references: [id])

  @@unique([feedbackRoundId, reviewerId])
  @@index([feedbackRoundId])
  @@index([reviewerId])
  @@index([status])
}

// ============ Phase 3: Meetings & Surveys ============

enum MeetingType {
  THREE_MONTH_REVIEW
  SIX_MONTH_REVIEW
  ANNUAL_REVIEW
  FEEDBACK_DISCUSSION
  GENERAL
}

enum SurveyType {
  NEW_JOINER_FEEDBACK
}

enum SurveyStatus {
  PENDING
  SUBMITTED
}

model MeetingMinutes {
  id              String         @id @default(cuid())
  type            MeetingType
  employeeId      String
  managerId       String
  feedbackRoundId String?
  date            DateTime
  notes           String
  actionItems     String?
  nextSteps       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  employee        User           @relation("MeetingEmployee", fields: [employeeId], references: [id])
  manager         User           @relation("MeetingManager", fields: [managerId], references: [id])
  feedbackRound   FeedbackRound? @relation(fields: [feedbackRoundId], references: [id])

  @@index([employeeId])
  @@index([managerId])
  @@index([feedbackRoundId])
  @@index([date])
}

model EmployeeSurvey {
  id          String       @id @default(cuid())
  employeeId  String
  type        SurveyType
  responses   Json?
  status      SurveyStatus @default(PENDING)
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  employee    User         @relation("SurveyEmployee", fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([type])
}

// ============ Phase 4: Exit Interviews ============

enum ExitInterviewStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
}

model ExitInterview {
  id            String              @id @default(cuid())
  employeeId    String
  managerId     String
  departureDate DateTime
  reason        String?
  status        ExitInterviewStatus @default(PENDING)
  responses     Json?
  notes         String?
  conductedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  employee      User                @relation("ExitInterviewEmployee", fields: [employeeId], references: [id])
  manager       User                @relation("ExitInterviewManager", fields: [managerId], references: [id])

  @@index([employeeId])
  @@index([managerId])
  @@index([status])
}
